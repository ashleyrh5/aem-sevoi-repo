          },
          {
            "name": "Image Right",
            "value": "image-right"
          },
          {
            "name": "Image Top",
            "value": "image-top"
          },
          {
            "name": "Image Bottom",
            "value": "image-bottom"
          }
        ]
      },
      {
        "component": "select",
        "name": "alignment",
        "label": "Alignment",
        "options": [
          {
            "name": "Text Left",
            "value": "text-left"
          },
          {
            "name": "Text Right",
            "value": "text-right"
          },
          {
