      {
        "component": "text",
        "valueType": "number",
        "name": "pageSize",
        "label": "Results Per Page",
        "value": "10",
        "description": "Number of search results to show per page in the expanded results view."
      },
      {
        "component": "aem-content",
        "valueType": "string",
        "name": "assetSearchPath",
        "label": "Asset Search Path",
        "description": "Optional DAM folder to include in search results (e.g. /content/dam/my-site). Assets are returned alongside pages — images render as thumbnails, documents as icons.",
        "validation": {
          "rootPath": "/content/dam"
        }
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "excludeAssetPaths",
        "label": "Excluded Asset Paths",
        "description": "Comma- or newline-separated DAM paths to exclude from asset search results. Any asset whose path starts with one of these prefixes is dropped. Example: /content/dam/my-site/internal, /content/dam/my-site/drafts"
      }
    ]
  }
