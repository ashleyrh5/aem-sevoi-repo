            "label": "Video Reference",
            "multi": false,
            "description": "Provide a URL for the video background."
          },
          {
            "component": "select",
            "name": "videoBehavior",
            "value": "autoplay",
            "label": "Video Behavior (on load)",
            "valueType": "string",
            "options": [
              {
                "name": "Autoplay",
                "value": "autoplay"
              },
              {
                "name": "Pause",
                "value": "pause"
              }
            ]
          }
        ]
      },
      {
        "component": "container",
        "label": "Image Properties",
        "name": "imageProperties",
        "valueType": "string",
        "condition": {
          "===": [
            {
              "var": "teaserStyle"
            },
            "image"
          ]
        },
        "fields": [
          {
            "component": "reference",
            "valueType": "string",
            "name": "imageRef",
            "label": "Image",
            "multi": false
          },
          {
            "component": "text",
            "valueType": "string",
            "name": "alt",
            "value": "Default alt",
            "label": "Alt Text"
          }
        ]
      },
      {
        "component": "container",
        "label": "Button Properties",
        "name": "buttonProperties",
        "valueType": "string",
        "fields": [
          {
            "component": "text",
            "valueType": "string",
            "name": "buttonText",
            "value": "Button",
            "label": "Button Text"
          },
          {
            "component": "aem-content",
            "name": "btn-link",
            "label": "Button Link",
            "valueType": "string",
            "rootPath": "",
            "description": "Path to linked AEM content"
          },
          {
            "component": "select",
            "name": "ctastyle",
            "label": "CTA Style",
            "valueType": "string",
            "value": "button",
            "options": [
              {
                "name": "Default Button",
                "value": "default"
              },
              {
                "name": "Primary Button",
                "value": "button"
              },
              {
                "name": "Secondary Button",
                "value": "button-secondary"
              },
              {
                "name": "Dark Button",
                "value": "button-dark"
              }
            ]
          }
        ]
      },
      {
        "component": "boolean",
        "label": "Enable Swoosh Effect",
        "description": "Enable Circular effect on the component",
        "name": "useSwoosh",
        "value": "true",
        "valueType": "boolean"
      }
    ]
  },
